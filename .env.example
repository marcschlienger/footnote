# Footnote configuration — copy to .env and fill in.

# Required: Parallel.ai Task API key (https://platform.parallel.ai)
PARALLEL_API_KEY=

# Optional: archive cited sources as local Markdown copies
# (https://firecrawl.dev — without it, reports still link every source)
FIRECRAWL_API_KEY=

# Where research dossiers are written. Point at a synced folder.
# Default on macOS: ~/Library/Mobile Documents/com~apple~CloudDocs/Research/inbox
# Default elsewhere: ~/Research/inbox
#OUTPUT_DIR=/path/to/your/notes/Research/inbox

# Research depth when the request doesn't specify
# (lite | base | core | core2x | pro | ultra | ultra2x | ultra4x | ultra8x,
#  each also as "<name>-fast")
DEFAULT_PROCESSOR=core

# How many cited sources to archive per report
MAX_SOURCES=12

# Optional: protect the server with a token (recommended outside a LAN).
# Clients send "Authorization: Bearer <token>" or ?token=…
#FOOTNOTE_TOKEN=

# Optional: Web Push notifications when research completes.
# Generate keys once:  .venv/bin/vapid --gen   (pip install py-vapid)
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_CLAIM_EMAIL=you@example.com

# Optional: mirror finished reports to a Notion database
#NOTION_API_KEY=
#NOTION_DATABASE_ID=

# Server bind (also as --host/--port flags)
#HOST=0.0.0.0
#PORT=8010

# Where job history and push subscriptions live (default: data/ next to app.py)
#DATA_DIR=
