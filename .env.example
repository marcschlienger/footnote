# Footnote configuration — copy to .env and fill in.

# Required: Parallel.ai Task API key (https://platform.parallel.ai)
PARALLEL_API_KEY=

# Optional: archive cited sources as local Markdown copies
# (https://firecrawl.dev — without it, reports still link every source)
FIRECRAWL_API_KEY=

# Where research dossiers are written. Point at a synced folder.
# Default on macOS: ~/Library/Mobile Documents/com~apple~CloudDocs/Research/inbox
# Default elsewhere: ~/Research/inbox
#OUTPUT_DIR=/path/to/your/notes/Research/inbox

# Research depth when the request doesn't specify
# (lite | base | core | core2x | pro | ultra | ultra2x | ultra4x | ultra8x,
#  each also as "<name>-fast")
DEFAULT_PROCESSOR=core

# How many cited sources to archive per report
MAX_SOURCES=12

# Firecrawl pacing. The defaults are the free plan's published limits — 10
# /scrape requests a minute, 2 concurrent browsers — so archiving stays inside
# them without configuration. Raise both on a paid plan; a rate limit of 0
# turns pacing off entirely.
FIRECRAWL_RATE_LIMIT=10
FIRECRAWL_CONCURRENCY=2

# Consult a site's robots.txt before archiving one of its pages. On by
# default. Footnote fetches pages that were already cited, one at a time,
# into a private folder — closer to a reader saving a copy than to crawling —
# but robots.txt is the only machine-readable way a site says "not by
# machine". A skipped source stays in the dossier with the reason recorded.
RESPECT_ROBOTS=true

# Optional: allow browser clients on other origins to call the API. Empty
# means no cross-origin access at all, which is right unless you have written
# a browser client of your own — the PWA is served from this origin, and the
# Shortcut and curl are not subject to CORS.
#FOOTNOTE_CORS_ORIGINS=https://your-client.example

# Optional: protect the server with a token (recommended outside a LAN).
# Clients send "Authorization: Bearer <token>" or ?token=…
#FOOTNOTE_TOKEN=

# Optional: Web Push notifications when research completes.
# Generate keys once:  .venv/bin/vapid --gen   (pip install py-vapid)
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_CLAIM_EMAIL=you@example.com

# Optional: mirror finished reports to a Notion database
#NOTION_API_KEY=
#NOTION_DATABASE_ID=

# Server bind (also as --host/--port flags)
#HOST=0.0.0.0
#PORT=8010

# Where job history and push subscriptions live (default: data/ next to app.py)
#DATA_DIR=
